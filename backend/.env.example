# Environment variables to configure in Render (or local testing)

# Port (Render sets this automatically, default is 8080)
PORT=8080

# Database Connection (e.g. from TiDB Cloud Serverless or other MySQL host)
DB_URL=jdbc:mysql://<host>:4000/<database>?sslMode=VERIFY_IDENTITY
DB_USERNAME=<username>
DB_PASSWORD=<password>

# JWT Secret (MUST be at least 32 characters long)
JWT_SECRET=your_32_character_long_super_secret_jwt_key_here!

# Allowed Frontend Origins (comma-separated, supports Vercel domains)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://medicare-hospital-system.vercel.app,https://*.vercel.app

# Demo Doctor Account (set DEMO_DOCTOR_PASSWORD in Render to initialize)
DEMO_DOCTOR_EMAIL=samuel.okafor@medicare.local
DEMO_DOCTOR_PASSWORD=your_demo_doctor_password_here
DEMO_DOCTOR_NAME=Dr. Samuel Okafor

